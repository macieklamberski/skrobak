{
  "name": "skrobak",
  "description": "Resilient web scraper with automatic retry, proxy rotation, and strategy cascade.",
  "repository": {
    "type": "git",
    "url": "https://github.com/macieklamberski/skrobak.git"
  },
  "homepage": "https://github.com/macieklamberski/skrobak",
  "bugs": {
    "url": "https://github.com/macieklamberski/skrobak/issues"
  },
  "author": "Maciej Lamberski",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown --format cjs,esm --dts --clean"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "undici": "^8.11.0"
  },
  "peerDependencies": {
    "playwright": "^1.63.0",
    "playwright-extra": "^4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "kvalita": "^1.24.3",
    "msw": "^2.15.0",
    "playwright": "^1.63.0",
    "playwright-extra": "^4.3.6",
    "trousse": "^2.2.1",
    "tsdown": "^0.23.0"
  },
  "patchedDependencies": {
    "puppeteer-extra-plugin-stealth@2.11.2": "patches/puppeteer-extra-plugin-stealth@2.11.2.patch"
  }
}
